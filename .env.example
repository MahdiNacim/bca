# Application
NODE_ENV=development
PORT=3179
APP_ORIGIN=http://localhost:3179
JWT_SECRET=replace-with-at-least-32-random-characters

# Identité BCA — à remplacer par les informations officielles
BCA_PHONE=01 00 00 00 00
BCA_PHONE_LINK=+33100000000
BCA_EMAIL=contact@example.fr
BCA_LEGAL_NAME=BCA
BCA_ADDRESS=14 rue Friedland, 18000 Bourges
BCA_SIREN=107 480 279
BCA_SIRET=107 480 279 00010
BCA_LEGAL_FORM=SASU au capital de 1 000 euros
BCA_RCS=107 480 279 RCS Bourges
BCA_APE=43.22B - Travaux d’installation d’équipements thermiques et de climatisation
BCA_SERVICE_AREA=Bourges et secteur à préciser
LEAD_RETENTION_DAYS=1095

# Compte administrateur
ADMIN_EMAIL=admin@example.fr
ADMIN_PASSWORD=change-this-strong-password

# Notification SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BCA <no-reply@example.fr>
LEAD_NOTIFICATION_TO=contact@example.fr
